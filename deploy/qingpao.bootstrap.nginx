server {
    listen 80;
    server_name www.lsstools01.site;
    client_max_body_size 64m;
    location / { proxy_pass http://127.0.0.1:8120; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 90s; }
}
