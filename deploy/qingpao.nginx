server {
    listen 80;
    server_name 1.lsstools.site;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name 1.lsstools.site;
    client_max_body_size 64m;
    ssl_certificate /etc/letsencrypt/live/1.lsstools.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/1.lsstools.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    location / { proxy_pass http://127.0.0.1:8120; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 90s; }
}
